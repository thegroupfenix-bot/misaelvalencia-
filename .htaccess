# ═══════════════════════════════════════════════════════════════
# GLV Services SAS — Apache/LiteSpeed Configuration
# URLs limpias + HTTPS + Caché + Seguridad
# Compatible: LiteSpeed + cPanel + Apache mod_rewrite
# ═══════════════════════════════════════════════════════════════

Options -Indexes
Options +FollowSymLinks
Options +SymLinksIfOwnerMatch

RewriteEngine On

# ── Rutas avícolas canónicas ─────────────────────────────────
# Se eliminan parámetros de versiones históricas y se preserva la ruta pública.
RewriteCond %{QUERY_STRING} ^v=20260915$ [NC]
RewriteRule ^pollo-colombiano$ /pollo-colombiano? [R=301,L]
RewriteCond %{QUERY_STRING} ^v=20260915$ [NC]
RewriteRule ^pollo-brasil$ /pollo-brasil? [R=301,L]

# ── Invalidar versiones cacheadas de navegación avícola ───────────────────
# El Home histórico carga este recurso sin versión; se sirve la versión actual.
RewriteCond %{QUERY_STRING} !^v=20260919$
RewriteRule ^assets/js/agri-navigation\.js$ /assets/js/agri-navigation.js?v=20260919 [R=302,L,NE]

# ── HTTPS forzado ────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Redirigir /index y /index.html a / ───────────────────────
RewriteRule ^index\.html?$ / [R=301,L,NC]

# ── Bloquear acceso directo a archivos .html ─────────────────
# Si alguien pide /page.html redirigir a /page (SEO canonical)
RewriteCond %{THE_REQUEST} \s/+([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── Servir archivos existentes directamente ──────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── URL limpia → archivo .html ───────────────────────────────
RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_URI}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ── Página 404 explícita ──────────────────────────────────────
# Una ruta inexistente no debe aparentar ser el Home.
ErrorDocument 404 /404.html

# ── Caché recursos estáticos ─────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg        "access plus 1 month"
  ExpiresByType image/png         "access plus 1 month"
  ExpiresByType image/webp        "access plus 1 month"
  ExpiresByType video/mp4         "access plus 1 month"
  ExpiresByType text/css          "access plus 1 week"
  ExpiresByType text/javascript   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# ── Compresión GZIP ──────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>

# Entrega la versión actual de la navegación dentro de HTML que aún conserva
# la referencia antigua ?v=1 en cachés intermedios.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  Substitute "s|/assets/js/agri-navigation.js?v=1|/assets/js/agri-navigation.js?v=20260919|ni"
  Substitute "s|</head>|<link rel=\"stylesheet\" href=\"/assets/css/production-refinements.css?v=20260919\"><script defer src=\"/assets/js/production-refinements.js?v=20260919\"></script></head>|ni"
</IfModule>

# ── Seguridad básica ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options  "nosniff"
  Header always set X-Frame-Options          "SAMEORIGIN"
  Header always set Referrer-Policy          "strict-origin-when-cross-origin"
</IfModule>
