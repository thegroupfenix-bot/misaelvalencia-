PORT=3001
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# SQLite DB path (relative to backend/)
DB_PATH=./db/glvconnect.sqlite

# Nodemailer – use an SMTP relay or Gmail app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@glvservicesexp.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM="GLV-Connect <notificaciones@glvservicesexp.com>"
MAIL_TO=contabilidad@glvservicesexp.com

# Frontend origins for CORS (comma-separated, no trailing slashes)
# REQUIRED in production (NODE_ENV=production) — server won't start without it.
# In development, *.up.railway.app origins are auto-allowed in addition to this list.
# Example production: https://glvservicesexp.com,https://www.glvservicesexp.com,https://gos.glvservicesexp.com
CLIENT_ORIGIN=http://localhost:5173

# Seed admin password (used only on first DB init when no users exist)
# If not set, a random password is generated and printed to console
# SEED_ADMIN_PASSWORD=

# PII encryption key — 64 hex chars (32 bytes AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PII_ENCRYPTION_KEY=
